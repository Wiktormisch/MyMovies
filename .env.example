# Copy this file to .env and fill in your own values.
# Never commit .env or any file containing real credentials.

# Django cryptographic signing key. Generate a fresh one per environment:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# If the value contains a dollar sign ($), escape it as $$ in this file.
SECRET_KEY=

# TMDB API key. Create one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Never True outside local development.
DEBUG=False

# Comma-separated hostnames this app may serve.
ALLOWED_HOSTS=

# Comma-separated origins allowed to send CSRF-protected requests,
# each including the scheme and port, e.g. http://example.com:8000
CSRF_TRUSTED_ORIGINS=

# For local development, use:
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
